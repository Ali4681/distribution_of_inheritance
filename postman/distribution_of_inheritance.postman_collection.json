    {
      "name": "Family Members",
      "item": [
        {
          "name": "Create Wife",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 or 200', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "if (data.id) pm.collectionVariables.set('member_id', data.id);",
                  "if (data.id && ['HUSBAND', 'WIFE'].includes(data.relationType)) {",
                  "  pm.collectionVariables.set('spouse_member_id', data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caseId\": \"{{case_id}}\",\n  \"fullName\": \"Fatimah Ahmad\",\n  \"gender\": \"FEMALE\",\n  \"relationType\": \"WIFE\",\n  \"isAlive\": true,\n  \"isMuslim\": true,\n  \"isMurderer\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/family-members",
            "description": "Creates a spouse record and stores spouse_member_id for child-linking."
          }
        },
        {
          "name": "Create Son Linked To Spouse",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 or 200', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "if (data.id) pm.collectionVariables.set('member_id', data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caseId\": \"{{case_id}}\",\n  \"spouseId\": \"{{spouse_member_id}}\",\n  \"fullName\": \"Omar Ahmad\",\n  \"gender\": \"MALE\",\n  \"relationType\": \"SON\",\n  \"isAlive\": true,\n  \"isMuslim\": true,\n  \"isMurderer\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/family-members",
            "description": "Creates a direct child linked to the stored spouse_member_id."
          }
        },
        {
          "name": "List Family Members",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/family-members",
            "description": "Lists all accessible family members."
          }
        },
        {
          "name": "List Family Members By Case",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const members = pm.response.json();",
                  "if (Array.isArray(members) && members.length) {",
                  "  if (members[0].id) pm.collectionVariables.set('member_id', members[0].id);",
                  "  const spouse = members.find((member) => ['HUSBAND', 'WIFE'].includes(member.relationType));",
                  "  if (spouse?.id) pm.collectionVariables.set('spouse_member_id', spouse.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/family-members?caseId={{case_id}}",
            "description": "Lists family members for the selected case."
          }
        },
        {
          "name": "Get Family Tree",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/family-members/tree/{{case_id}}",
            "description": "Returns the computed family tree structure for the case."
          }
        },
        {
          "name": "Get Family Member By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/family-members/{{member_id}}",
            "description": "Returns a single family member."
          }
        },
        {
          "name": "Update Family Member",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
