{
  "info": {
    "name": "Distribution Of Inheritance API",
    "description": "Complete self-contained Postman collection for the NestJS API exposed under /api. This file includes the collection variables needed to run requests without a separate environment file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "auth_token",
      "value": ""
    },
    {
      "key": "user_email",
      "value": "admin@example.com"
    },
    {
      "key": "user_password",
      "value": "secret123"
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "user_role",
      "value": ""
    },
    {
      "key": "target_user_id",
      "value": ""
    },
    {
      "key": "case_id",
      "value": ""
    },
    {
      "key": "member_id",
      "value": ""
    },
    {
      "key": "spouse_member_id",
      "value": ""
    },
    {
      "key": "heir_id",
      "value": ""
    },
    {
      "key": "page",
      "value": "1"
    },
    {
      "key": "limit",
      "value": "20"
    },
    {
      "key": "language",
      "value": "AR"
    },
    {
      "key": "usage_note",
      "value": "Import this collection only. Run Sign Up Admin or Sign In first to populate auth_token, then create a case to populate case_id."
    }
  ],
  "item": [
    {
      "name": "App",
      "item": [
        {
          "name": "Root",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}",
            "description": "Basic API root check."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign Up Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 or 200', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "const requestData = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
                  "",
                  "if (requestData.email) pm.collectionVariables.set('user_email', requestData.email);",
                  "if (requestData.password) pm.collectionVariables.set('user_password', requestData.password);",
                  "if (data.token) pm.collectionVariables.set('auth_token', data.token);",
                  "if (data.user?.id) pm.collectionVariables.set('user_id', data.user.id);",
                  "if (data.user?.role) pm.collectionVariables.set('user_role', data.user.role);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin User\",\n  \"email\": \"admin+{{$timestamp}}@example.com\",\n  \"password\": \"secret123\",\n  \"role\": \"ADMIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/auth/signup",
            "description": "Creates an admin account and stores auth variables from the response."
          }
        },
        {
          "name": "Sign Up User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 or 200', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "const requestData = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
                  "",
                  "if (requestData.email) pm.collectionVariables.set('user_email', requestData.email);",
                  "if (requestData.password) pm.collectionVariables.set('user_password', requestData.password);",
                  "if (data.token) pm.collectionVariables.set('auth_token', data.token);",
                  "if (data.user?.id) pm.collectionVariables.set('user_id', data.user.id);",
                  "if (data.user?.role) pm.collectionVariables.set('user_role', data.user.role);",
                  "if (data.user?.id && data.user?.role !== 'ADMIN') pm.collectionVariables.set('target_user_id', data.user.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Regular User\",\n  \"email\": \"user+{{$timestamp}}@example.com\",\n  \"password\": \"secret123\",\n  \"role\": \"USER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/auth/signup",
            "description": "Creates a regular user. Useful for later admin user-management tests."
          }
        },
        {
          "name": "Sign In",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "const requestData = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
                  "",
                  "if (requestData.email) pm.collectionVariables.set('user_email', requestData.email);",
                  "if (requestData.password) pm.collectionVariables.set('user_password', requestData.password);",
                  "if (data.token) pm.collectionVariables.set('auth_token', data.token);",
                  "if (data.user?.id) pm.collectionVariables.set('user_id', data.user.id);",
                  "if (data.user?.role) pm.collectionVariables.set('user_role', data.user.role);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/auth/signin",
            "description": "Signs in with the current collection variables and refreshes the bearer token."
          }
        },
        {
          "name": "Edit Current User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Account Name\",\n  \"email\": \"{{user_email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/auth/edit/{{user_id}}",
            "description": "Updates the currently signed-in account."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get My Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "if (data.id) pm.collectionVariables.set('user_id', data.id);",
                  "if (data.role) pm.collectionVariables.set('user_role', data.role);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/users/me",
            "description": "Returns the current authenticated user."
          }
        },
        {
          "name": "List Users (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const users = pm.response.json();",
                  "if (Array.isArray(users) && users.length) {",
                  "  const currentId = pm.collectionVariables.get('user_id');",
                  "  const target = users.find((user) => user.id && user.id !== currentId) || users[0];",
                  "  if (target?.id) pm.collectionVariables.set('target_user_id', target.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/users",
            "description": "Admin only. Lists all users and stores a target user id when possible."
          }
        },
        {
          "name": "Get User By Id (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/users/{{target_user_id}}",
            "description": "Admin only. Set target_user_id first if needed."
          }
        },
        {
          "name": "Update User (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Managed User\",\n  \"role\": \"USER\",\n  \"isActive\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/users/{{target_user_id}}",
            "description": "Admin only. Updates the target user."
          }
        },
        {
          "name": "Delete User (Admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/users/{{target_user_id}}",
            "description": "Admin only. Deletes the target user."
          }
        }
      ]
    },
    {
